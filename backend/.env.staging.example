# .env.staging.example
# Copia este archivo como .env en el servidor de staging y completa los valores reales.
# NUNCA subas el .env real al repositorio.

# ── Entorno ───────────────────────────────────────────────────────────────────
ENVIRONMENT=staging

# Barreras manuales de deploy. Definirlas solo para la ejecución actual,
# después de verificar el destino y crear un snapshot reciente:
# STAGING_DEPLOY_CONFIRMATION=INKORA_STAGING
# STAGING_BACKUP_ID=<id o timestamp del snapshot>
# Identificador real del proyecto/base de staging. Debe aparecer en DATABASE_URL
# y no puede ser una palabra genérica.
# STAGING_TARGET_ID=<project-ref-staging>
# Misma huella de entrega configurada en API, worker y frontend.
# RELEASE_ID=<git-sha-o-huella-inmutable>

# ── Base de datos ─────────────────────────────────────────────────────────────
# Supabase Postgres (Transaction Mode pooler recomendado para staging)
DATABASE_URL=postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres?sslmode=require
# Opcional: si está disponible, deploy_staging.sh rechaza DATABASE_URL cuando
# coincide exactamente con la URL de producción.
# PRODUCTION_DATABASE_URL=postgresql://...
DB_POOL_SIZE=3
DB_MAX_OVERFLOW=2
DB_POOL_TIMEOUT_SECONDS=30
DB_POOL_RECYCLE_SECONDS=1800

# ── Seguridad JWT ─────────────────────────────────────────────────────────────
SECRET_KEY=<genera con: python -c "import secrets; print(secrets.token_hex(32))">
FIELD_ENCRYPTION_KEY=<genera con: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())">
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# ── Token interno (para crear tenants vía API) ────────────────────────────────
INTERNAL_PROVISIONING_TOKEN=<genera con: python -c "import secrets; print(secrets.token_urlsafe(32))">

# ── URLs ──────────────────────────────────────────────────────────────────────
# Debe apuntar al dominio real de staging (no localhost)
BACKEND_URL=https://api.staging.tudominio.com
CORS_ALLOW_ORIGINS=https://staging.tudominio.com,https://www.staging.tudominio.com

# ── Supabase Storage ─────────────────────────────────────────────────────────
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_KEY=<publishable key local opcional>
SUPABASE_SERVICE_ROLE_KEY=<service role key solo en Railway/backend>
SUPABASE_STORAGE_BUCKET=printflow-archivos-staging

# ── APIs Perú ─────────────────────────────────────────────────────────────────
API_URL=https://facturacion.apisperu.com/api/v1
API_TOKEN=<tu token de apisperu.com>
SMARTPSE_BASE_URL=https://panel.smartpse.pe
SMARTPSE_API_TOKEN=<tu API token de gestion Smart PSE>
SMARTPSE_TIMEOUT_SECONDS=30
DNIRUC_API_URL=https://dniruc.apisperu.com/api/v1
DNIRUC_TOKEN=<token dniruc — puede quedar vacío si no se usa>
FACTILIZA_API_URL=https://api.factiliza.com/v1
FACTILIZA_API_TOKEN=<token de API Consulta Factiliza>
FACTILIZA_TIMEOUT_SECONDS=10
EMISSION_MODE_DEFAULT=async
EMISSION_WORKER_POLL_SECONDS=3
# Worker v2: primero migración 0025, luego API compatible y worker antiguo drenado.
EMISSION_WORKER_WAKE_MODE=poll
EMISSION_EVENT_TENANT_IDS=
EMISSION_LISTEN_DATABASE_URL=
EMISSION_WORKER_FALLBACK_SECONDS=60
EMISSION_GLOBAL_CONCURRENCY=1
EMISSION_TENANT_CONCURRENCY=1
EMISSION_WORKER_CONCURRENCY=1
EMISSION_LEASE_SECONDS=300
EMISSION_HEARTBEAT_SECONDS=30
# En modo notify, copiar la URL de sesión (5432, TLS) del panel del MISMO proyecto.
# No reutilizar la URL transaccional 6543 para LISTEN. IDs: 12,34; * habilita todos.
EMISSION_STALE_RECOVERY_INTERVAL_SECONDS=60
EMISSION_MAX_ATTEMPTS=5
EMISSION_RETRY_BASE_SECONDS=15
EMISSION_PROCESSING_TIMEOUT_SECONDS=300
FISCAL_ENV=beta

# ── Límites de archivo ────────────────────────────────────────────────────────
MAX_LOGO_UPLOAD_BYTES=2097152
MAX_AI_UPLOAD_BYTES=10485760

# ── Logs ──────────────────────────────────────────────────────────────────────
LOG_LEVEL=INFO

# ── Seguridad DB ─────────────────────────────────────────────────────────────
# NUNCA activar en staging ni producción
INIT_DB_ON_STARTUP=false

# ── Congelado para launch scope ───────────────────────────────────────────────
GEMINI_API_KEY=
