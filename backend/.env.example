ENVIRONMENT=development

# Para Supabase con PgBouncer, usar puerto 6543 y agregar ?pgbouncer=true
# DATABASE_URL=postgresql://user:pass@db.xxx.supabase.co:6543/postgres?pgbouncer=true
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/printflow

SECRET_KEY=replace-with-a-long-random-secret
FIELD_ENCRYPTION_KEY=
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
LOG_LEVEL=INFO

BACKEND_URL=http://localhost:8000
CORS_ALLOW_ORIGINS=http://localhost:5173,http://localhost:5174,http://localhost:3000,http://127.0.0.1:5173
INIT_DB_ON_STARTUP=false

# Pool de conexiones DB
# Con PgBouncer: usar valores bajos (pool_size=5, max_overflow=10)
# Sin PgBouncer: subir a (pool_size=20, max_overflow=30)
DB_POOL_SIZE=3
DB_MAX_OVERFLOW=2
DB_POOL_TIMEOUT_SECONDS=30
DB_POOL_RECYCLE_SECONDS=1800
DB_POOL_PING=true

INTERNAL_PROVISIONING_TOKEN=replace-with-internal-onboarding-token

API_URL=https://facturacion.apisperu.com/api/v1
API_TOKEN=
SMARTPSE_BASE_URL=https://panel.smartpse.pe
SMARTPSE_API_TOKEN=
SMARTPSE_TIMEOUT_SECONDS=30
DNIRUC_API_URL=https://dniruc.apisperu.com/api/v1
DNIRUC_TOKEN=

# Cola de emisión fiscal
EMISSION_MODE_DEFAULT=sync
EMISSION_WORKER_POLL_SECONDS=2
EMISSION_MAX_ATTEMPTS=5
EMISSION_RETRY_BASE_SECONDS=15
EMISSION_PROCESSING_TIMEOUT_SECONDS=300
EMISSION_WORKER_CONCURRENCY=3

SUPABASE_URL=
SUPABASE_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=printflow-archivos

MAX_LOGO_UPLOAD_BYTES=2097152
MAX_AI_UPLOAD_BYTES=10485760

# Congelado para launch scope; solo completar si se usa internamente.
GEMINI_API_KEY=
